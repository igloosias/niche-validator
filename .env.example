# Environment Variables Example
# Copy this file to .env and fill in your API keys

# ============================================
# FIRECRAWL - Web Scraping API (RECOMMENDED)
# ============================================
# Get free API key at: https://firecrawl.dev
# Free tier: 500 credits/month
VITE_FIRECRAWL_API_KEY=your_firecrawl_api_key

# ===========================================
# PYTHON BACKEND SERVER (for advanced scrapers)
# ===========================================
# Required for: ScrapeGraphAI, Agent-Reach, pytrends-modern, Crawl4AI
# Run: python server/scraper_server.py
VITE_SCRAPER_SERVER_URL=http://localhost:8000

# ============================================
# GOOGLE TRENDS - Search Demand Data
# ============================================
# Get API key at: https://console.cloud.google.com/
# Free tier: 1,000 requests/day
VITE_GOOGLE_TRENDS_API_KEY=your_google_api_key

# ============================================
# YOUTUBE DATA API - Video Analysis
# ============================================
# Get API key at: https://console.cloud.google.com/
# Free tier: 10,000 units/day
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# ============================================
# REDDIT API - Community Sentiment
# ============================================
# Get credentials at: https://www.reddit.com/prefs/apps
# Free tier: 60 requests/minute
VITE_REDDIT_CLIENT_ID=your_client_id
VITE_REDDIT_CLIENT_SECRET=your_client_secret
